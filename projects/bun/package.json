{
  "name": "ciutil-bun",
  "version": "1.0.0",
  "private": true,
  "description": "CRC-32, Adler-32, Base64, Roman numeral and SemVer utilities with a small CLI",
  "type": "module",
  "module": "src/bin.ts",
  "scripts": {
    "build": "bun build --compile --outfile dist/ciutil src/bin.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
