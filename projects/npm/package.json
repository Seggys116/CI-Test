{
  "name": "ciutil-npm",
  "version": "1.0.0",
  "private": true,
  "description": "CRC-32, Adler-32, Base64, Roman numeral and SemVer utilities with a small CLI",
  "type": "module",
  "bin": {
    "ciutil": "dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node dist/bin.js version"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
