{
  "name": "ciutil-pnpm",
  "version": "1.0.0",
  "private": true,
  "description": "CRC-32, Adler-32, Base64, Roman numeral and SemVer utilities as a pnpm workspace",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:all": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node packages/cli/dist/bin.js version"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
